{
  "name": "kingdom-of-records",
  "private": true,
  "version": "0.1.0",
  "description": "A pixel-art web game to learn SQL in the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
