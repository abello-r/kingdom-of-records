    "codemirror": "^6.0.2",
    "sql.js": "^1.17.0"
  },
  "devDependencies": {
    "@types/sql.js": "^1.16.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
